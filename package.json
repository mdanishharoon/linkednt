{
  "name": "linkednt-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "treefmt",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "ext:dev": "bun --filter '@linkednt/extension' dev",
    "ext:build": "bun --filter '@linkednt/extension' build",
    "ext:typecheck": "bun --filter '@linkednt/extension' typecheck",
    "ext:test": "bun --filter '@linkednt/extension' test",
    "landing:dev": "bun --filter '@linkednt/landing' dev",
    "landing:build": "bun --filter '@linkednt/landing' build",
    "landing:typecheck": "bun --filter '@linkednt/landing' typecheck"
  }
}
