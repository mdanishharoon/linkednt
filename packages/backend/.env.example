# Copy to .env.local — never commit the real one (root .gitignore already
# blocks .env*). These are for `supabase functions serve` local development;
# in production they're set via `supabase secrets set KEY=value`.

# Provider keys — used server-side when path=proxy
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# Google OAuth — for Supabase Auth's Google provider
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Polar webhook secret — for verifying order.paid webhook signatures
POLAR_WEBHOOK_SECRET=base64-...
POLAR_ACCESS_TOKEN=polar_oat_...

# Proxy hardening knobs — read by the /rewrite edge function.
# DAILY_PAID_CAP: per-user soft cap on paid-path credits per UTC day.
# DAILY_CREDIT_CEILING: global circuit breaker; if today's summed cost_credits
# across all users >= this, /rewrite returns 503 until UTC midnight. Set to 0
# (or omit) to disable.
DAILY_PAID_CAP=500
DAILY_CREDIT_CEILING=10000
