# Copy to .env.local — never commit the real one (root .gitignore already
# blocks .env*). These are for `supabase functions serve` local development;
# in production they're set via `supabase secrets set KEY=value`.

# Provider keys — used server-side when path=proxy
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# Google OAuth — for Supabase Auth's Google provider
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Polar environment switch — flipping this single value swaps both the
# Polar API base AND which token below is used. Set to "production" only
# when you intend live charges; "sandbox" (the default) for everything else.
POLAR_ENV=sandbox

# Polar API access tokens — keep BOTH set so flipping POLAR_ENV is a
# one-command switch (no token churn). create-polar-checkout reads the
# one that matches POLAR_ENV.
POLAR_ACCESS_TOKEN=polar_oat_...         # live org token
POLAR_SANDBOX_TOKEN=polar_oat_...        # sandbox org token

# Polar webhook signing secrets — keep BOTH set so webhook endpoints in
# either Polar dashboard can stay configured pointing at the same
# Supabase URL. polar-webhook verifies against both and accepts whichever
# HMAC matches.
POLAR_WEBHOOK_SECRET=polar_whs_...           # live webhook secret
POLAR_SANDBOX_WEBHOOK_SECRET=polar_whs_...   # sandbox webhook secret

# Proxy hardening knobs — read by the /rewrite edge function.
# DAILY_PAID_CAP: per-user soft cap on paid-path credits per UTC day.
# DAILY_CREDIT_CEILING: global circuit breaker; if today's summed cost_credits
# across all users >= this, /rewrite returns 503 until UTC midnight. Set to 0
# (or omit) to disable.
DAILY_PAID_CAP=500
DAILY_CREDIT_CEILING=10000
