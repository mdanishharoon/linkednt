# Copy to .env.local — never commit the real one (root .gitignore already
# blocks .env*). These are for `supabase functions serve` local development;
# in production they're set via `supabase secrets set KEY=value`.

# Provider keys — used server-side when path=proxy
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# Google OAuth — for Supabase Auth's Google provider
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Polar webhook secret — used by /polar-webhook to verify order.paid
# signature HMACs from Polar. Sandbox and production have separate
# secrets; this MUST match the env you're pointing at.
POLAR_WEBHOOK_SECRET=base64-...
# Polar API access token — used by /create-polar-checkout to create a
# checkout session via Polar's API (with metadata.user_id +
# metadata.credits baked in so /polar-webhook can credit the right user).
# Sandbox tokens won't authenticate against the production API and vice
# versa, so this has to match POLAR_ENV.
POLAR_ACCESS_TOKEN=polar_oat_...
# Polar environment — "sandbox" (default, safe) or "production". The
# /create-polar-checkout fn picks the API base from this; webhook
# verification doesn't care because the secret already pins one env.
POLAR_ENV=sandbox

# Proxy hardening knobs — read by the /rewrite edge function.
# DAILY_PAID_CAP: per-user soft cap on paid-path credits per UTC day.
# DAILY_CREDIT_CEILING: global circuit breaker; if today's summed cost_credits
# across all users >= this, /rewrite returns 503 until UTC midnight. Set to 0
# (or omit) to disable.
DAILY_PAID_CAP=500
DAILY_CREDIT_CEILING=10000
