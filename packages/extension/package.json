{
  "name": "@linkednt/extension",
  "displayName": "linkedn't",
  "version": "0.1.1",
  "description": "Unslop your LinkedIn feed. Rewrites posts into plain English, a dry translation, or the author's internal monologue.",
  "scripts": {
    "dev": "plasmo dev",
    "build:dev": "plasmo build --tag=development",
    "build:prod": "plasmo build",
    "package:dev": "plasmo build --tag=development && plasmo package --tag=development",
    "package:prod": "plasmo build && plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=dot --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "plasmo": "^0.90.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "zod": "^3.25.76",
    "lucide-react": "^1.16.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "vitest": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^29.1.1",
    "vitest-chrome": "^0.1.0",
    "webextension-polyfill": "^0.12.0",
    "@types/webextension-polyfill": "^0.12.0"
  },
  "manifest": {
    "host_permissions": [
      "https://www.linkedin.com/*",
      "https://api.groq.com/*",
      "https://api.openai.com/*",
      "https://api.anthropic.com/*",
      "https://generativelanguage.googleapis.com/*",
      "https://openrouter.ai/*"
    ],
    "permissions": [
      "storage",
      "identity"
    ]
  },
  "plasmo": {
    "srcDirectory": "./src"
  }
}
