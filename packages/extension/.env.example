# Copy to .env.development / .env.production and fill in.
# `PLASMO_PUBLIC_*` vars get baked into the extension bundle at build time
# (they are NOT secret — visible to anyone who unpacks the .crx).

PLASMO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PLASMO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Build-time site URL used in OAuth redirect URLs.
PLASMO_PUBLIC_SITE_URL=https://linkednt.com
