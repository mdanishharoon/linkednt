# Landing build-time env (Next.js). All NEXT_PUBLIC_* values are inlined into
# the client bundle at build time and are NOT secret (visible in page source).
#
# In CI these are set as GitHub Actions Variables and mirrored into the build.
# For local dev, copy to `.env.local` and fill in. Root .gitignore blocks
# .env.* except this example file.

# --- Supabase (must match the project the edge functions are deployed to) ---
# Sandbox project:
#   NEXT_PUBLIC_SUPABASE_URL=https://sihdgzbbdlpzrgsfjfqw.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_yFmOU1wjODjvNZe9wknzlQ_vqw1ePnv
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Polar credit-pack product UUIDs ---
# Environment-specific: a sandbox product UUID does not exist in production
# and vice versa. Supply the set that matches the POLAR_ENV the
# create-polar-checkout edge function is pointing at. A missing/empty value
# disables that pack's Buy button ("Coming soon").
#
# Sandbox UUIDs are created in the sandbox.polar.sh dashboard (or via the
# polar-sandbox MCP); paste them here once they exist.
NEXT_PUBLIC_POLAR_PRODUCT_UNEMPLOYED=
NEXT_PUBLIC_POLAR_PRODUCT_OPEN_TO_WORK=
NEXT_PUBLIC_POLAR_PRODUCT_THOUGHT_LEADER=
